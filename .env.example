PORT=3000

# Punto de venta en tablet vía Mercado Pago Point
# Si se dejan vacías, el módulo funciona en modo mock/simulado automáticamente.
MP_ACCESS_TOKEN= # Access token de Mercado Pago
MP_TERMINAL_ID= # ID de la terminal Point
MP_WEBHOOK_SECRET= # Secreto de validación de webhooks del panel de Mercado Pago

# Panel de administración (/admin) — HTTP Basic Auth, una sola cuenta.
# IMPORTANTE: si ADMIN_PASSWORD queda vacío, /admin responde 503 (no
# disponible) en vez de quedar abierto sin protección o con un password
# default adivinable ("fail closed"). Configura ambas para habilitar el panel.
ADMIN_USER= # Usuario del panel de administración (default: "admin" si se deja vacío)
ADMIN_PASSWORD= # Password del panel de administración. Sin esto, /admin da 503.
